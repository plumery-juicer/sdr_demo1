options:
  parameters:
    author: RMUC2026-NC
    catch_exceptions: 'True'
    category: '[RMUC2026-NC]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Single-device full-duplex self loopback flow graph. TX and RX share
      one NanoSDR URI and one selected RMUC wave profile. Added SIC alpha/delay estimator
      based on latest user-provided graph.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: RMUC2026_NanoSDR_TRX
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: RMUC2026 NanoSDR TRX
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

